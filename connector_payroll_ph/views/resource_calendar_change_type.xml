<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="odoo_resource_calendar_change_type_tree_view" model="ir.ui.view">
        <field name="name">odoo.resource.calendar.change.type.tree</field>
        <field name="model">odoo.resource.calendar.change.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="odoo_id" />
                <field name="backend_id" />
                <field name="external_id" />
                <button name="resync" type="object" string="Resync" />
            </tree>
        </field>
    </record>

    <record id="odoo_resource_calendar_change_type_form_view" model="ir.ui.view">
        <field name="name">odoo.resource.calendar.change.type.form</field>
        <field name="model">odoo.resource.calendar.change.type</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="resync" type="object" string="Resync" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                        <group>
                            <field name="code" />
                            <field name="odoo_id" readonly="0" />
                            <field name="backend_id" readonly="1" />
                            <field name="external_id" readonly="0" />
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
