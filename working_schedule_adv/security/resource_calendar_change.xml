<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="resource_calendar_change_user" model="ir.rule">
            <field name="name">Work Schedule Change Request base.group_user read</field>
            <field name="model_id" ref="model_resource_calendar_change"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4,ref('hr_attendance.group_hr_attendance_own_reader'))]"/>
        </record>

        <record id="resource_calendar_change_user_update" model="ir.rule">
            <field name="name">Work Schedule Change Request: Officer Restrict to Managed Employees</field>
            <field name="model_id" ref="model_resource_calendar_change"/>
            <field name="domain_force">[
                '|',
                '&amp;',
                ('employee_id.attendance_manager_id', '=', user.id),
                 ('employee_id.user_id', '=', user.id),
                '&amp;',
                ('employee_id.user_id', '!=', user.id),
                ('employee_id.attendance_manager_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4,ref('hr_attendance.group_hr_attendance_officer'))]"/>
        </record>

        <record id="resource_calendar_change_admin" model="ir.rule">
            <field name="name">Work Schedule Change Request: Admin</field>
            <field name="model_id" ref="model_resource_calendar_change"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4,ref('hr.group_hr_manager'))]"/>
        </record>
    </data>
</odoo>