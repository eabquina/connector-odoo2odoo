<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resource_calendar_view_form_working_schedule_adv" model="ir.ui.view">
        <field name="name">resource.calendar.view.form.inherit.working_schedule_adv</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <data>
                <div name="button_box" position="inside">
                    <button class="oe_stat_button" name="action_open_schedule_changes" 
                            type="object" icon="fa-calendar" groups="hr_contract.group_hr_contract_manager">
                        <field name="work_changes_count" string="Schedule Changes" widget="statinfo"/>
                    </button>
                </div>
            </data>
        </field>
    </record>
    <record id="resource_calendar_view_tree_working_schedule_adv" model="ir.ui.view">
        <field name="name">resource.calendar.view.tree.inherit.working_schedule_adv</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_tree"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="work_changes_count"/>
            </field>
        </field>
    </record>
</odoo>
