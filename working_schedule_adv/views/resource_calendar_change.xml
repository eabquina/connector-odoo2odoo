<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Views -->
    <!-- Form View -->
    <record id="resource_calendar_change_form_view" model="ir.ui.view">
        <field name="name">resource.calendar.change.form</field>
        <field name="model">resource.calendar.change</field>
        <field name="arch" type="xml">
            <form string="Work Schedule Change Request">
                <header>
                    <field name="state" widget="statusbar"/>
                    <field name="current_user_boolean" invisible="1"/>

                    <button name="submit" string="Submit"
                            type="object" class="btn-primary"
                            invisible="state not in ('draft')" />

                    <button name="confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state in ('draft','confirm','cancel','refuse')"/>

                    <button name="reject" string="Refuse" type="object"
                            class="btn-primary"
                            invisible="state in ('draft','confirm','cancel','refuse')"/>

                    <button name="draft" string="Set to Draft" type="object"
                            class="btn-secondary"
                            invisible="state in ('draft') or current_user_boolean == True"/>
                    <button name="cancel" string="Cancel" type="object"
                            class="btn-secondary"
                            invisible="state in ('draft','sent','confirm') or current_user_boolean == True"/>
                    
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="0"
                                    placeholder="Reference ...."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"
                                    options="{'no_quick_create': True, 'no_create_edit' : True}" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="manager_id"/>
                            
                            <field name="current_user_boolean"
                                    invisible="1"/>
                            <field name="purpose"/>
                            <field name="cancel_reason"/>
                        </group>
                        <group>
                            <field name="current_user" invisible="1"/>
                            <field name="contract_id"/>
                            <field name="resource_calendar_id"/>
                            <field name="type_id"/>
                            <field name="duration"/>
                            <field name="calendar_to" invisible="duration == 'day'"/>
                            <field name="date_from" invisible="duration == 'day'"/>
                            <field name="date_to" invisible="duration == 'day'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Change Lines" name="change_lines">
                            <field  name="change_lines" 
                                    widget="section_and_note_one2many"
                                    mode="tree,kanband">
                                <form>                                        
                                    <field name="date"/>
                                    <field name="employee_id" readonly="1"/>
                                    <field name="calendar_from" readonly="1"/>
                                    <field name="calendar_to"/>
                                    <field name="type_id"/>
                                    <field name="reason"/>
                                </form>
                                <tree string="Change Lines" default_order="date asc" editable="bottom" >
                                    <field name="date"/>
                                    <field name="employee_id" readonly="1" optional="hide"/>
                                    <field name="calendar_from" optional="hide"/>
                                    <field name="calendar_to"/>
                                    <field name="type_id" />
                                    <field name="reason" optional="show"/>
                                </tree>
                                <kanban class="o_kanban_mobile">
                                    <field name="date"/>
                                    <field name="employee_id" readonly="1" optional="hide"/>
                                    <field name="calendar_from" readonly="1"/>
                                    <field name="calendar_to"/>
                                    <field name="type_id"/>
                                    <field name="reason"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_card oe_kanban_global_click ps-0 pe-0">
                                                <div class="row g-0">
                                                    <div class="col-12">
                                                        <t t-out="record.name.value"/>
                                                        <t t-out="record.date"/>
                                                        <t t-out="record.calendar_from"/>
                                                        <t t-out="record.calendar_to"/>
                                                        <t t-out="record.type_id"/>
                                                    </div>
                                                </div>                                                    
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                            widget="mail_followers"
                            groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="resource_calendar_change_tree_view" model="ir.ui.view">
        <field name="name">resource.calendar.change.tree.view</field>
        <field name="model">resource.calendar.change</field>
        <field name="arch" type="xml">
            <tree string="Work Schedule Change Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="manager_id" optional="show"/>
                <field name="resource_calendar_id" optional="show"/>
                <field name="duration" optional="show"/>
                <field name="state" optional="show"/>
                <field name="type_id" optional="show"/>
                <field name="change_lines" string="Change Lines" optional="show"/>
            </tree>
        </field>
    </record>
    <record id="resource_calendar_change_lines_tree_view" model="ir.ui.view">
        <field name="name">resource.calendar.change.lines.tree.view</field>
        <field name="model">resource.calendar.change.lines</field>
        <field name="arch" type="xml">
            <tree string="Work Schedule Change Lines">
                <field name="request_id"/>
                <field name="date" optional="show"/>
                <field name="employee_id" optional="hide"/>
                <field name="calendar_from" optional="show"/>
                <field name="calendar_to" optional="show"/>
                <field name="reason" optional="show"/>
                <field name="type_id" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <!-- Work Schedule -->
    <record id="resource_calendar_change_action" model="ir.actions.act_window">
        <field name="name">Work Schedule Change Request</field>
        <field name="res_model">resource.calendar.change</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to New create a Work Schedule Request.
            </p>
        </field>
    </record>
    <record id="resource_calendar_change_type_action" model="ir.actions.act_window">
        <field name="name">Work Schedule Change Request Type</field>
        <field name="res_model">resource.calendar.change.type</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to New create a Work Schedule Request Type.
            </p>
        </field>
    </record>


    <!-- MenuItems -->
    <menuitem id="resource_calendar_change_submenu" name="Work Schedule Request"
                groups="base.group_user" web_icon="working_schedule_adv,static/description/techops_working_schedule_adv.png"/>
    <menuitem id="resource_calendar_change" name="Requests"
                parent="resource_calendar_change_submenu"
                action="resource_calendar_change_action"
                groups="base.group_user"/>
    <menuitem id="resource_calendar_change_requests" name="Requests"
                parent="resource_calendar_change"
                action="resource_calendar_change_action"
                groups="base.group_user"/>

    <menuitem id="resource_calendar_change_config" name="Configuration"
                parent="resource_calendar_change_submenu"
                groups="hr.group_hr_manager"/>
    <menuitem id="resource_calendar_change_type" name="Request Types"
                parent="resource_calendar_change_config"
                action="resource_calendar_change_type_action"
                groups="hr.group_hr_manager"/>
    </data>
</odoo>
