<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="odoo_account_move_tree_view" model="ir.ui.view">
        <field name="name">odoo.account.move.tree</field>
        <field name="model">odoo.account.move</field>

        <field name="arch" type="xml">
            <list
                decoration-danger="import_state in ('error_sync', 'error_amount')"
                decoration-warning="import_state == 'waiting'"
            >
                <field name="display_name" />
                <field name="odoo_id" />
                <field name="backend_id" />
                <field name="external_id" />
                <field name="backend_amount_total" readonly="1" />
                <field name="backend_amount_residual" readonly="1" />
                <field name="backend_move_line_count" readonly="1" />
                <field name="synced_move_line_count" readonly="1" />
                <field name="import_state" />
                <button name="resync" type="object" string="Resync" />
                <button name="sync_move_lines" type="object" string="Sync Lines" />
            </list>
        </field>
    </record>

    <record id="odoo_account_move_form_view" model="ir.ui.view">
        <field name="name">odoo.account.move.form</field>
        <field name="model">odoo.account.move</field>

        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="resync" type="object" string="Resync" />
                    <button name="sync_move_lines" type="object" string="Sync Lines" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                        <group>
                            <field name="odoo_id" readonly="1" />
                            <field name="backend_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                            <field name="backend_amount_total" readonly="1" />
                            <field name="backend_amount_residual" readonly="1" />
                            <field name="backend_state" readonly="1" />
                            <field name="backend_move_line_count" readonly="1" />
                            <field name="synced_move_line_count" readonly="1" />
                            <field name="import_state" />
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odoo_account_move_line_tree_view" model="ir.ui.view">
        <field name="name">odoo.account.move.line.tree</field>
        <field name="model">odoo.account.move.line</field>

        <field name="arch" type="xml">
            <list>
                <field name="display_name" />
                <field name="backend_id" />
                <field name="external_id" />
                <field name="move_id" />
                <field name="account_id" />
                <field name="partner_id" />
                <field name="debit" />
                <field name="credit" />
                <button name="resync" type="object" string="Resync" />
            </list>
        </field>
    </record>

    <record id="odoo_account_move_line_form_view" model="ir.ui.view">
        <field name="name">odoo.account.move.line.form</field>
        <field name="model">odoo.account.move.line</field>

        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="resync" type="object" string="Resync" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="odoo_id" readonly="1" />
                            <field name="backend_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                            <field name="move_id" readonly="1" />
                        </group>
                        <group>
                            <field name="account_id" readonly="1" />
                            <field name="partner_id" readonly="1" />
                            <field name="product_id" readonly="1" />
                            <field name="debit" readonly="1" />
                            <field name="credit" readonly="1" />
                            <field name="amount_currency" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <field name="name" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_move_connector_form" model="ir.ui.view">
        <field name="name">account.move.connector.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="connector" string="Connector">
                    <group string="Odoo Bindings">
                        <field name="bind_ids" readonly="1" nolabel="1">
                            <list
                                decoration-danger="import_state in ('error_sync', 'error_amount')"
                                decoration-warning="import_state == 'waiting'"
                            >
                                <field name="backend_id" />
                                <field name="external_id" />
                                <field name="backend_amount_total" readonly="1" />
                                <field name="backend_amount_residual" readonly="1" />
                                <field name="backend_move_line_count" readonly="1" />
                                <field name="synced_move_line_count" readonly="1" />
                                <field name="import_state" />
                                <button name="resync" type="object" string="Resync" />
                                <button
                                    name="sync_move_lines"
                                    type="object"
                                    string="Sync Lines"
                                />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
