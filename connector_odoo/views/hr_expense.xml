<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- hr.expense.sheet views -->
    <record id="odoo_hr_expense_sheet_tree_view" model="ir.ui.view">
        <field name="name">odoo.hr.expense.sheet.tree</field>
        <field name="model">odoo.hr.expense.sheet</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="import_state in ('error_sync', 'error_amount')"
                decoration-warning="import_state == 'waiting'"
            >
                <field name="display_name" />
                <field name="odoo_id" />
                <field name="backend_id" />
                <field name="external_id" />
                <field name="backend_total_amount" readonly="1" />
                <field name="backend_state" readonly="1" />
                <field name="backend_expense_count" readonly="1" />
                <field name="synced_expense_count" readonly="1" />
                <field name="import_state" />
                <button name="resync" type="object" string="Resync" />
                <button name="sync_expenses" type="object" string="Sync Expenses" />
            </list>
        </field>
    </record>

    <record id="odoo_hr_expense_sheet_form_view" model="ir.ui.view">
        <field name="name">odoo.hr.expense.sheet.form</field>
        <field name="model">odoo.hr.expense.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="resync" type="object" string="Resync" />
                    <button name="sync_expenses" type="object" string="Sync Expenses" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" /></h1>
                        <group>
                            <field name="odoo_id" readonly="1" />
                            <field name="backend_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                            <field name="backend_total_amount" readonly="1" />
                            <field name="backend_state" readonly="1" />
                            <field name="backend_expense_count" readonly="1" />
                            <field name="synced_expense_count" readonly="1" />
                            <field name="import_state" />
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- hr.expense views -->
    <record id="odoo_hr_expense_tree_view" model="ir.ui.view">
        <field name="name">odoo.hr.expense.tree</field>
        <field name="model">odoo.hr.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" />
                <field name="backend_id" />
                <field name="external_id" />
                <field name="employee_id" />
                <field name="product_id" />
                <field name="total_amount" />
                <field name="sheet_id" />
                <button name="resync" type="object" string="Resync" />
            </list>
        </field>
    </record>

    <record id="odoo_hr_expense_form_view" model="ir.ui.view">
        <field name="name">odoo.hr.expense.form</field>
        <field name="model">odoo.hr.expense</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="resync" type="object" string="Resync" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="odoo_id" readonly="1" />
                            <field name="backend_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                            <field name="sheet_id" readonly="1" />
                        </group>
                        <group>
                            <field name="employee_id" readonly="1" />
                            <field name="product_id" readonly="1" />
                            <field name="total_amount" readonly="1" />
                            <field name="date" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <field name="name" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inherit on hr.expense.sheet form to show bindings -->
    <record id="view_hr_expense_sheet_connector_form" model="ir.ui.view">
        <field name="name">hr.expense.sheet.connector.form</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="connector" string="Connector">
                    <group string="Odoo Bindings">
                        <field name="bind_ids" readonly="1" nolabel="1">
                            <list
                                decoration-danger="import_state in ('error_sync', 'error_amount')"
                                decoration-warning="import_state == 'waiting'"
                            >
                                <field name="backend_id" />
                                <field name="external_id" />
                                <field name="backend_total_amount" readonly="1" />
                                <field name="backend_state" readonly="1" />
                                <field name="import_state" />
                                <button name="resync" type="object" string="Resync" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
