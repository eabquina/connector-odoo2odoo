<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="odoo_account_payment_tree_view" model="ir.ui.view">
        <field name="name">odoo.account.payment.tree</field>
        <field name="model">odoo.account.payment</field>

        <field name="arch" type="xml">
            <list
                decoration-danger="import_state == 'error_amount'"
                decoration-warning="import_state == 'waiting'"
            >
                <field name="display_name" />
                <field name="odoo_id" />
                <field name="backend_id" />
                <field name="external_id" />
                <field name="backend_amount" readonly="1" />
                <field name="backend_state" readonly="1" />
                <field name="import_state" />
                <button name="resync" type="object" string="Resync" />
            </list>
        </field>
    </record>

    <record id="odoo_account_payment_form_view" model="ir.ui.view">
        <field name="name">odoo.account.payment.form</field>
        <field name="model">odoo.account.payment</field>

        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="resync" type="object" string="Resync" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                        <group>
                            <field name="odoo_id" readonly="1" />
                            <field name="backend_id" readonly="1" />
                            <field name="external_id" readonly="1" />
                            <field name="backend_amount" readonly="1" />
                            <field name="backend_state" readonly="1" />
                            <field name="import_state" />
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_payment_connector_form" model="ir.ui.view">
        <field name="name">account.payment.connector.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="connector" string="Connector">
                    <group string="Odoo Bindings">
                        <field name="bind_ids" readonly="1" nolabel="1">
                            <list
                                decoration-danger="import_state == 'error_amount'"
                                decoration-warning="import_state == 'waiting'"
                            >
                                <field name="backend_id" />
                                <field name="external_id" />
                                <field name="backend_amount" readonly="1" />
                                <field name="backend_state" readonly="1" />
                                <field name="import_state" />
                                <button name="resync" type="object" string="Resync" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
