<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_odoo_backend_tree" model="ir.ui.view">
      <field name="name">odoo.backend.list</field>
      <field name="model">odoo.backend</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" />
          <field name="version" />
          <field name="hostname" />
          <field name="port" />
          <field name="database" />
          <field name="state" />
        </list>
      </field>
    </record>

    <record id="view_odoo_backend_form" model="ir.ui.view">
      <field name="name">odoo.backend.form</field>
      <field name="model">odoo.backend</field>
      <field name="arch" type="xml">
        <form string="Odoo Backend">
          <header>
            <button
                        name="synchronize_basedata"
                        type="object"
                        class="oe_highlight"
                        invisible="state in ('draft')"
                        string="Synchronize Base Datas"
                        help="Synchronize UOM, Categories, etc..."
                    />
            <button
                        name="button_check_connection"
                        type="object"
                        class="oe_highlight"
                        string="Check Connection"
                        invisible="state not in ('draft')"
                    />
            <button
                        name="button_reset_to_draft"
                        type="object"
                        string="Reset To draft Connection"
                        invisible="state in ('draft')"
                    />
            <field name="state" widget="statusbar" />
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">

    <field name="active" invisible="1" />
    <widget
                            name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            invisible="active == True"
                        />


            </div>
            <label for="name" />
            <h1>
              <field name="name" class="oe_inline" />
            </h1>
            <group>
              <group>
                <field name="hostname" />
                <field name="version" />
                <field name="protocol" />
                <field name="port" />
                <field name="rpc_timeout" />
                <field name="default_lang_id" />
              </group>
              <group>
                <field name="database" />
                <field name="login" />
                <field name="password" password="True" />
                <field name="pricelist_id" />
        <field name="force" />
        <field name="ignore_translations" />
              </group>
            </group>
            <notebook>
              <page string="Product" name="product_page">
                <group name="prod_import_export_options">
                  <group string="Import / Export">

                                    <field name="work_with_variants" />
                    <field name="default_import_product" />
                    <field name="default_export_product" />

                    <div>
                      <label for="matching_product_product" string="Match On" />
                      <field name="matching_product_product" class="oe_inline" />
                      <field name="matching_product_ch" />
                    </div>
                  </group>
                  <group string="General ">
                    <field
                                        name="local_product_domain_filter"
                                        string="Local Product Filter"
                                    />
                    <field
                                        name="external_product_domain_filter"
                                        string="Ext. Product Filter"
                                    />
                    <field
                                        name="local_uom_uom_domain_filter"
                                        string="Local UOM Filter"
                                    />
                    <field
                                        name="external_uom_uom_domain_filter"
                                        string="Ext. UOM Filter"
                                    />
                    <field
                                        name="external_product_pricelist_domain_filter"
                                        string="Local Product Filter"
                                    />
                    <field
                                        name="default_product_export_dict"
                                        string="Default Values"
                                        help="Default Dictionnary with values for creating products"
                                        invisible="default_export_product != True"
                                    />
                  </group>
                </group>
                <group>
                  <group name="prod_import_operations" string="Import Operations">
                    <group>
                      <div
                                            invisible="default_import_product != True"
                                        >
                        <button
                                                name="import_product_categories"
                                                type="object"
                                                string="Import Categories"
                                                class="oe_highlight oe_inline"
                                                help="Import Categories"
                                                nolabel="1"
                                            />
                      </div>
                      <div
                                            invisible="default_import_product != True"
                                        >
                        <field
                                                name="import_categories_from_date"
                                                class="oe_inline"
                                                nolabel="1"
                                            />
                      </div>
                    </group>
                    <group>
                      <div
                                            invisible="default_import_product != True"
                                        >
                        <button
                                                name="import_product_product"
                                                type="object"
                                                string="Import Product"
                                                class="oe_highlight oe_inline"
                                                help="Import Product"
                                                nolabel="1"
                                            />
                      </div>
                      <div
                                            invisible="default_import_product != True"
                                        >
                        <field
                                                name="import_product_from_date"
                                                class="oe_inline"
                                                nolabel="1"
                                            />
                      </div>

                    </group>
                    <group>
                      <div
                                            invisible="default_import_product != True"
                                        >
                        <button
                                                name="import_product_pricelist_item"
                                                type="object"
                                                string="Import Pricelists"
                                                class="oe_highlight oe_inline"
                                                help="Import Pricelists"
                                                nolabel="1"
                                            />
                      </div>
                      <div
                                            invisible="default_import_product != True"
                                        >
                        <field
                                                name="import_pricelist_items_from_date"
                                                class="oe_inline"
                                                nolabel="1"
                                            />
                      </div>
                    </group>
                  </group>
                  <group name="prod_export_operations" string="Export operations">

                    <group>
                      <div
                                            invisible="default_export_product != True"
                                        >
                        <button
                                                name="export_product_categories"
                                                type="object"
                                                string="Export Categories"
                                                class="oe_highlight oe_inline"
                                                help="Export Categories"
                                                nolabel="1"
                                            />
                      </div>
                      <div
                                            invisible="default_export_product != True"
                                        >
                        <field
                                                name="export_categories_from_date"
                                                class="oe_inline"
                                                nolabel="1"
                                            />
                      </div>
                    </group>

                    <group>
                      <div
                                            invisible="default_export_product != True"
                                        >
                        <button
                                                name="export_product_templates"
                                                type="object"
                                                string="Export Product templates"
                                                class="oe_highlight oe_inline"
                                                help="Export Products Templates"
                                                nolabel="1"
                                            />
                      </div>
                      <div
                                            invisible="default_export_product != True"
                                        >
                        <button
                                                name="export_product_products"
                                                type="object"
                                                string="Export Product"
                                                class="oe_highlight oe_inline"
                                                help="Export Products"
                                                nolabel="1"
                                            />
                      </div>
                      <div
                                            invisible="default_export_product != True"
                                        >
                        <field
                                                name="export_products_from_date"
                                                class="oe_inline"
                                                nolabel="1"
                                            />
                      </div>
                    </group>
                  </group>

                </group>
              </page>
              <page string="Partners" name="partners">
                <group>
                  <group string="Import / Export">
                    <field name="default_import_partner" />
                    <field name="default_export_partner" />
                  </group>
                  <group string="General ">
                    <field name="local_partner_domain_filter" />
                    <field name="external_partner_domain_filter" />
                  </group>
                  <group name="partner_import_operations" string="Import Operations">
                    <div
                                        invisible="default_import_partner != True"
                                    >
                      <button
                                            name="import_partner"
                                            type="object"
                                            string="Import Partner"
                                            class="oe_highlight oe_inline"
                                            help="Import Partner"
                                            nolabel="1"
                                        />
                    </div>
                    <div
                                        invisible="default_import_partner != True"
                                    >
                      <field
                                            name="import_partner_from_date"
                                            class="oe_inline"
                                            nolabel="1"
                                        />
                    </div>
                  </group>

                </group>
              </page>
              <page string="Users" name="users">
                <group>
                  <group string="Import / Export">
                    <field name="default_import_user" />
                    <field name="default_export_user" />
                  </group>
                  <group string="General ">
                    <field name="local_user_domain_filter" />
                    <field name="external_user_domain_filter" />
                  </group>
                  <group>
                    <div invisible="default_import_user != True">
                      <button
                                            name="import_user"
                                            type="object"
                                            string="Import User"
                                            class="oe_highlight oe_inline"
                                            help="Import User"
                                            nolabel="1"
                                        />
                    </div>
                    <div invisible="default_import_user != True">
                      <field
                                            name="import_user_from_date"
                                            class="oe_inline"
                                            nolabel="1"
                                        />
                    </div>
                  </group>

                </group>
              </page>
              <page string="Logistic" name="logistic">

                  <group string="General">
                    <field name="main_record" />
                    <field name="read_operation_from" />
                    <field name="delayed_import_lines" />
                </group>
                <group string="Purchases">
                    <group>
                        <field name="default_import_purchase_order" />
                      </group>
                      <group>
                        <div
                                        invisible="default_import_purchase_order != True"
                                    >
                      <button
                                            name="import_purchase_orders"
                                            type="object"
                                            string="Import Purchase Orders"
                                            class="oe_highlight oe_inline"
                                            nolabel="1"
                                        />
                    </div>
                    <div
                                        invisible="default_import_purchase_order != True"
                                    >
                                    <field
                                            name="import_purchase_order_from_date"
                                            nolabel="1"
                                        />
                    </div>

                      </group>
                </group>
                <group string="Sales">
                    <group>
                        <field name="default_import_sale_order" />
                      </group>
                      <group>
                        <div
                                        invisible="default_import_sale_order != True"
                                    >
                      <button
                                            name="import_sale_orders"
                                            type="object"
                                            string="Import Sale Orders"
                                            class="oe_highlight oe_inline"
                                            nolabel="1"
                                        />
                    </div>
                    <div
                                        invisible="default_import_sale_order != True"
                                    >
                                    <field
                                            name="import_sale_order_from_date"
                                            nolabel="1"
                                        />
                    </div>

                      </group>
                </group>
                <group string="Stock" name="stock">
                    <group>
                        <field name="default_import_stock" />
                    </group>
                    <group>
                        <div
                                        invisible="default_import_stock != True"
                                    >
                            <button
                                            name="import_warehouses"
                                            type="object"
                                            string="Import Warehouses"
                                            class="oe_highlight oe_inline"
                                            nolabel="1"
                                        />
                        </div>
                    </group>
                    <group>
                        <div
                                        invisible="default_import_stock != True"
                                    >
                            <field
                                            name="import_warehouse_from_date"
                                            nolabel="1"
                                        />
                        </div>
                    </group>
                    <group>
                        <div
                                        invisible="default_import_stock != True"
                                    >
                            <button
                                            name="import_locations"
                                            type="object"
                                            string="Import Locations"
                                            class="oe_highlight oe_inline"
                                            nolabel="1"
                                        />
                        </div>
                    </group>
                    <group>
                        <div
                                        invisible="default_import_stock != True"
                                    >
                            <field
                                            name="import_stock_from_date"
                                            nolabel="1"
                                        />
                        </div>
                    </group>
                    <group>
                        <button
                                        name="import_pickings"
                                        invisible="default_import_stock != True"
                                        type="object"
                                        string="Import Pickings"
                                        class="oe_highlight oe_inline"
                                        nolabel="1"
                                    />
                    </group>
                    <group />
                    <group>
                        <button
                                        name="import_stock_inventories"
                                        type="object"
                                        invisible="default_import_stock != True"
                                        string="Import Inventory Adjustments"
                                        class="oe_highlight oe_inline"
                                        nolabel="1"
                                    />
                    </group>
                </group>
              </page>
              <page string="Account" name="account">
                <group>
                  <group string="Import / Export">
                    <field name="default_import_account" />
                    <field name="default_export_account" />
                    <field name="default_import_account_tax" />
                    <field name="default_import_account_payment_term" />
                    <field name="default_import_account_fiscal_position" />
                    <field name="default_import_account_journal" />
                    <field name="default_import_account_move" />
                    <field name="default_import_account_payment" />
                  </group>
                  <group string="General ">
                    <field name="local_account_domain_filter" />
                    <field name="external_account_domain_filter" />
                    <field
                        name="external_account_journal_domain_filter"
                        string="Ext. Journal Filter"
                        invisible="default_import_account_journal != True"
                    />
                    <field
                        name="external_account_move_domain_filter"
                        string="Ext. Move Filter"
                        invisible="default_import_account_move != True"
                    />
                    <field
                        name="external_account_payment_domain_filter"
                        string="Ext. Payment Filter"
                        invisible="default_import_account_payment != True"
                    />
                  </group>
                </group>
                <group string="Import Operations">
                  <group name="account_import_operations">
                    <group>
                      <div invisible="default_import_account != True">
                        <button
                            name="import_account_account"
                            type="object"
                            string="Import Accounts"
                            class="oe_highlight oe_inline"
                            help="Import Chart of Accounts"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_account != True">
                        <field
                            name="import_account_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                    <group>
                      <div invisible="default_import_account_tax != True">
                        <button
                            name="import_account_tax"
                            type="object"
                            string="Import Taxes"
                            class="oe_highlight oe_inline"
                            help="Import Tax Groups and Taxes"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_account_tax != True">
                        <field
                            name="import_account_tax_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                    <group>
                      <div invisible="default_import_account_payment_term != True">
                        <button
                            name="import_account_payment_term"
                            type="object"
                            string="Import Payment Terms"
                            class="oe_highlight oe_inline"
                            help="Import Payment Terms"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_account_payment_term != True">
                        <field
                            name="import_account_payment_term_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                    <group>
                      <div invisible="default_import_account_fiscal_position != True">
                        <button
                            name="import_account_fiscal_position"
                            type="object"
                            string="Import Fiscal Positions"
                            class="oe_highlight oe_inline"
                            help="Import Fiscal Positions with Tax/Account Mappings"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_account_fiscal_position != True">
                        <field
                            name="import_account_fiscal_position_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                    <group>
                      <div invisible="default_import_account_journal != True">
                        <button
                            name="import_account_journal"
                            type="object"
                            string="Import Journals"
                            class="oe_highlight oe_inline"
                            help="Import Account Journals"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_account_journal != True">
                        <field
                            name="import_account_journal_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                    <group>
                      <div invisible="default_import_account_move != True">
                        <button
                            name="import_account_move"
                            type="object"
                            string="Import Journal Entries / Invoices"
                            class="oe_highlight oe_inline"
                            help="Import Account Moves (Invoices, Bills, Journal Entries)"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_account_move != True">
                        <field
                            name="import_account_move_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                    <group>
                      <div invisible="default_import_account_payment != True">
                        <button
                            name="import_account_payment"
                            type="object"
                            string="Import Payments"
                            class="oe_highlight oe_inline"
                            help="Import Account Payments"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_account_payment != True">
                        <field
                            name="import_account_payment_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                  </group>
                </group>
              </page>
              <page string="HR / Expenses" name="hr_expense">
                <group>
                  <group string="Import">
                    <field name="default_import_hr_employee" />
                    <field name="default_import_hr_expense" />
                  </group>
                  <group string="General ">
                    <field
                        name="external_hr_employee_domain_filter"
                        string="Ext. Employee Filter"
                        invisible="default_import_hr_employee != True"
                    />
                    <field
                        name="external_hr_expense_domain_filter"
                        string="Ext. Expense Filter"
                        invisible="default_import_hr_expense != True"
                    />
                  </group>
                </group>
                <group string="Import Operations">
                  <group>
                    <group>
                      <div invisible="default_import_hr_employee != True">
                        <button
                            name="import_hr_employee"
                            type="object"
                            string="Import Employees"
                            class="oe_highlight oe_inline"
                            help="Import Employees"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_hr_employee != True">
                        <field
                            name="import_hr_employee_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                    <group>
                      <div invisible="default_import_hr_expense != True">
                        <button
                            name="import_hr_expense"
                            type="object"
                            string="Import Expense Reports"
                            class="oe_highlight oe_inline"
                            help="Import Expense Sheets and Expenses"
                            nolabel="1"
                        />
                      </div>
                      <div invisible="default_import_hr_expense != True">
                        <field
                            name="import_hr_expense_from_date"
                            class="oe_inline"
                            nolabel="1"
                        />
                      </div>
                    </group>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_odoo_backend" model="ir.actions.act_window">
      <field name="name">Odoo Backends</field>
      <field name="res_model">odoo.backend</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_odoo_root"
        name="Odoo"
        parent="connector.menu_connector_root"
        sequence="1"
    />
    <!-- TODO: Implement security strategy groups="odoo_base.group_oc_manager" -->
    <menuitem
        id="menu_odoo_backends"
        name="Backends"
        parent="menu_odoo_root"
        action="action_odoo_backend"
        sequence="1"
    />

</odoo>
