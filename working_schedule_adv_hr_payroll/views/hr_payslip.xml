<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_inherited_view_resource_calendar_change_lines" model="ir.ui.view">
            <field name="name">hr.payslip.inherited.view.resource.calendar.change.lines</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='country_id']" position="after">
                    <field name="request_change_lines" invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='account_info']" position="after">
                    <page string="Work Schedule Changes" name="request_change_lines">
                        <field name="request_change_lines" widget="one2many_list">
                            <tree>
                                <field name="request_id"/>
                                <field name="date" optional="show"/>
                                <field name="employee_id" optional="hide"/>
                                <field name="calendar_from" optional="show"/>
                                <field name="calendar_to" optional="show"/>
                                <field name="reason" optional="show"/>
                                <field name="type_id" optional="show"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
</odoo>
