<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="odoo_resource_calendar_change_lines_tree_view" model="ir.ui.view">
        <field name="name">odoo.resource.calendar.change.lines.tree</field>
        <field name="model">odoo.resource.calendar.change.lines</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_id" />
                <field name="date" />
                <field name="employee_id" />
                <field name="calendar_to" />
                <field name="type_id" />
                <field name="backend_id" />
                <field name="external_id" />
                <button name="resync" type="object" string="Resync" />
            </list>
        </field>
    </record>

    <record id="odoo_resource_calendar_change_lines_form_view" model="ir.ui.view">
        <field name="name">odoo.resource.calendar.change.lines.form</field>
        <field name="model">odoo.resource.calendar.change.lines</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="resync" type="object" string="Resync" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id" />
                            <field name="date" />
                            <field name="calendar_to" />
                            <field name="type_id" />
                            <field name="reason" />
                        </group>
                        <group>
                            <field name="odoo_id" readonly="0" />
                            <field name="backend_id" readonly="1" />
                            <field name="external_id" readonly="0" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
